rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /messages/{id} {
      allow read: if request.auth != null
        && request.auth.token.phone_number in resource.data.members
        && resource.data.expireAt > request.time;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.token.phone_number
        && request.auth.token.phone_number in request.resource.data.members
        && request.resource.data.members.size() <= 2
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
